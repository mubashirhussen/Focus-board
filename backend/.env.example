# FocusBoard Backend Configuration
PROJECT_NAME="FocusBoard API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # "development" | "staging" | "production" | "testing"
DEBUG=false

# Security & Tokens
SECRET_KEY="focusboard_production_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL="sqlite:///./focusboard.db"
# DATABASE_URL="postgresql+psycopg://focusboard:focusboard123@postgres:5432/focusboard_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# File Upload Limits
UPLOAD_MAX_BYTES=20971520 # 20MB

# Optional Redis Cache / Queue
REDIS_URL=""

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# AI Configuration (Phase 14)
AI_PROVIDER="mock" # "mock" | "gemini" | "openai"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048

# Email & Notification System (Phase 15)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="notifications@focusboard.io"
EMAIL_ENABLED=false
