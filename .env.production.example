# ==============================================================================
# FocusBoard Production Environment Configuration Template
# NOTE: Never commit production values to source control.
# Set these variables securely in your cloud provider environment settings.
# ==============================================================================

# 1. Environment & Logging
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# 2. Application Core Settings
PORT=8000
SECRET_KEY=generate_a_64_character_hex_or_base64_string_using_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Production Managed PostgreSQL (e.g. Neon, Supabase, AWS RDS)
# Enforce SSL/TLS: ?sslmode=require
DATABASE_URL=postgresql+psycopg://focusboard_user:strong_production_password@ep-sample-123.us-east-1.aws.neon.tech/focusboard_prod?sslmode=require

# 4. Production Redis Cache & Queue (e.g. Upstash, AWS ElastiCache)
REDIS_URL=rediss://default:redis_secure_token@sample-redis-cluster.upstash.io:6379

# 5. Production CORS & Security Headers
# Explicit JSON array of approved frontend origins (No wildcards)
CORS_ORIGINS=["https://app.focusboard.app","https://focusboard.app"]
ALLOWED_HOSTS=["api.focusboard.app","app.focusboard.app"]

# 6. Web Push (VAPID Keys for PWA notifications)
VAPID_PUBLIC_KEY=your_generated_vapid_public_key_here
VAPID_PRIVATE_KEY=your_generated_vapid_private_key_here
VAPID_SUBJECT=mailto:security@focusboard.app

# 7. SaaS Billing & Stripe Integration (Sandbox/Live)
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_signing_secret

# 8. External Integrations (Google Calendar OAuth)
GOOGLE_CLIENT_ID=your_production_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://api.focusboard.app/api/v1/integrations/google-calendar/callback

# 9. AI Productivity Provider (Gemini / Anthropic / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_production_gemini_api_key

# 10. SMTP Email Service (for invitations & notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
SMTP_FROM_EMAIL=noreply@focusboard.app

# 11. Frontend Production Environment Variables (Baked into Vite build)
VITE_API_URL=https://api.focusboard.app/api/v1
