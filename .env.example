# FocusBoard Application Environment Configuration Example

# Frontend Configuration
VITE_APP_TITLE=FocusBoard
VITE_APP_STORAGE_KEY=focusboard_tasks
VITE_API_URL=http://localhost:8000/api/v1

# Security & JWT Tokens
SECRET_KEY=your_production_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email OTP Delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=notifications@focusboard.io
SMTP_FROM_NAME=FocusBoard
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_ENABLED=true

# Email OTP Throttling & Policy
OTP_LENGTH=6
OTP_EXPIRATION_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Google OAuth 2.0 & Identity
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_OAUTH_ENABLED=true

# Database & CORS
DATABASE_URL=sqlite:///./focusboard.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
